#!/bin/bash
set -o nounset -o errexit -o errtrace -o pipefail

MOODLE_DOCKER_BASE="$(realpath "$(dirname "$0")/..")"
PATH="$MOODLE_DOCKER_BASE/bin:$PATH"
export MOODLE_DOCKER_BASE PATH

read_dotenv() {
	if [[ -f "$1" ]]; then
		set -o allexport
		# shellcheck disable=SC1090
		. "$1"
		set +o allexport
	elif [[ "${2:-}" == "require" ]]; then
		echo "mdc: missing required config file: $1" >&2
		exit 1
	fi
}

if [[ "${1:-}" == "-i" ]]; then
	MOODLE_DOCKER_INSTANCE="$2"
	shift 2
fi

read_dotenv "$MOODLE_DOCKER_BASE/config/common.env"

# shellcheck disable=SC2153
if declare -p MOODLE_DOCKER_INSTANCES >/dev/null 2>&1; then
	: "${MOODLE_DOCKER_INSTANCE:="$MOODLE_DOCKER_DEFAULT_INSTANCE"}"
	: "${MOODLE_DOCKER_INSTANCE:?}"
	
	read_dotenv "$MOODLE_DOCKER_BASE/config/$MOODLE_DOCKER_INSTANCE.env" require

	: "${COMPOSE_PROJECT_NAME:="$MOODLE_DOCKER_INSTANCE"}"
	export MOODLE_DOCKER_INSTANCE COMPOSE_PROJECT_NAME
fi

install_xdebug() {
	local bash_args=(-o nounset -o errexit -o errtrace)
	# Pass shell debug option from host to container.
	test -o xtrace && bash_args+=(-x) || true

	mdc exec -T webserver bash "${bash_args[@]}" <<EOF1
pecl shell-test xdebug || pecl install xdebug

mkdir -p /usr/local/etc/php/conf.d
cat >/usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini <<EOF2
; Settings for Xdebug Docker configuration
xdebug.mode = debug
xdebug.client_host = host.docker.internal
EOF2

docker-php-ext-enable xdebug
EOF1
	mdc restart webserver
}

install_moodle_db() {
	# From https://docs.moodle.org/402/en/Administration_via_command_line#Installation
	mdc php admin/cli/install_database.php --agree-license \
		--adminpass=admin --adminemail=a@b.c \
		--supportemail=a@b.c \
		--fullname="Moodle-Docker" --shortname="moodle-docker"
}

case "${1:-}" in
xdebug)
	install_xdebug
	;;
install)
	install_moodle_db
	;;
psql)
	shift
	exec "$0" exec -it db psql -U moodle "$@"
	;;
shell)
	shift
	exec "$0" exec --user www-data -it webserver bash
	;;
php)
	shift
	exec moodle-docker-php "$@"
	;;
*)
	exec moodle-docker-compose "$@"
	;;
esac
